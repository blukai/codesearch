{{block "page.index" .}}
  {{template "layout.head" .}}
  {{if .Query}}
    {{range $_, $file := .Files}}
      {{$lastBreadcrumb := index $file.Breadcrumbs (sub (len $file.Breadcrumbs) 1)}}
      {{$filename := printf "%s/%s" $lastBreadcrumb.Dirname $lastBreadcrumb.Basename}}
      <a href="{{$filename}}?q={{$.Query}}" class="file-header">
        {{- range $_, $breadcrumb := $file.Breadcrumbs -}}
          {{- if $breadcrumb.IsOutOfRoot -}}
            <span class="text-gray">/{{$breadcrumb.Basename}}</span>
          {{- else if $breadcrumb.IsDir -}}
            /{{$breadcrumb.Basename}}
          {{- else -}}
            /<b>{{$breadcrumb.Basename}}</b>
          {{- end -}}
        {{- end -}}
      </a>
      {{range $_, $match := $file.Matches}}
        <a href="{{$filename}}?q={{$.Query}}#l{{$match.LineNo}}" class="source-hunk">
          <div class="source-line">
            {{- printf "%*d  " $.LinePad $match.LineNo -}}
            {{- $end := 0 -}}
            {{- range $_, $loc := $match.Locations -}}
              {{- printf "%s" (slice $match.Line $end (index $loc 0)) -}}
              <mark>{{printf "%s" (slice $match.Line (index $loc 0) (index $loc 1))}}</mark>
              {{- $end = index $loc 1 -}}
            {{- end -}}
            {{- printf "%s" (slice $match.Line $end) -}}
          </div>
        </a>
      {{end}}
    {{end}}
    <div>
      rendered {{.MatchCount}} matches in {{printf "%.3fs" .TimeElapsed}}
    </div>
  {{end}}
  {{template "layout.foot" .}}
{{end}}
