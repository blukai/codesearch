{{block "page.index" .}}
  {{template "layout.head" .}}
  {{if .Query}}
    {{range $_, $file := .Files}}
      <a href="{{$file.Filename}}?q={{$.Query}}" class="file-header">
        {{$file.Filename}}
      </a>
      {{range $_, $match := $file.Matches}}
        <a href="{{$file.Filename}}?q={{$.Query}}#l{{$match.LineNo}}" class="source-hunk">
          <div class="source-line">
            {{- printf "%*d  " $.LinePad $match.LineNo -}}
            {{- $end := 0 -}}
            {{- range $_, $loc := $match.Locations -}}
              {{- printf "%s" (slice $match.Line $end (index $loc 0)) -}}
              <mark>{{printf "%s" (slice $match.Line (index $loc 0) (index $loc 1))}}</mark>
              {{- $end = index $loc 1 -}}
            {{- end -}}
            {{- printf "%s" (slice $match.Line $end) -}}
          </div>
        </a>
      {{end}}
    {{end}}
    <div>
      rendered {{.MatchCount}} matches in {{printf "%.3fs" .TimeElapsed}}
    </div>
  {{end}}
  {{template "layout.foot" .}}
{{end}}
