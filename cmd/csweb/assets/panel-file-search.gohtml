{{- /* ARGS: map of Path, Query, FileSearch */ -}}
{{define "component.panel-file-search"}}
  <section class="panel panel--file-search" id="panel-file-search">
    <div>
      <form action="/" class="p-m pb-0 w-full">
        <input
          type="text"
          name="q"
          value="{{.Query}}"
          placeholder="pattern"
          class="w-full"
          id="file-search-input"
        />
        <button type="submit" class="hidden"></button>
      </form>
      {{if .FileSearch}}
        <div class="px-m py-s divide-b">
          {{.FileSearch.MatchCount}} {{selectplural .FileSearch.MatchCount "match" "matches"}}
          in
          {{len .FileSearch.Results}} {{selectplural (len .FileSearch.Results) "file" "files"}}
          ({{printf "%.3fs" .FileSearch.TimeElapsed}})
        </div>
      {{end}}
    </div>
    {{if .FileSearch}}
      <div class="panel-content" tabIndex="-1">
        {{range $i, $result := .FileSearch.Results}}
          {{$lastBreadcrumb := index $result.Breadcrumbs (sub (len $result.Breadcrumbs) 1)}}
          {{$filename := printf "%s/%s" $lastBreadcrumb.Dirname $lastBreadcrumb.Basename}}
          <div class="file-header px-m py-xs divide-b{{if eq $filename $.Path}} file-header--selected{{end}}">
            <a href="{{$filename}}?q={{$.Query}}" id="search-result-{{$i}}">
              {{- range $_, $breadcrumb := $result.Breadcrumbs -}}
                {{- if $breadcrumb.IsOutOfRoot -}}
                  <span class="fg-disabled">/{{$breadcrumb.Basename}}</span>
                {{- else if $breadcrumb.IsDir -}}
                  /{{$breadcrumb.Basename}}
                {{- else -}}
                  /<b>{{$breadcrumb.Basename}}</b>
                {{- end -}}
              {{- end -}}
            </a>
          </div>
          {{range $_, $hunk := $result.Hunks}}
            <a
              href="{{$filename}}?q={{$.Query}}#l{{index $hunk.MatchedLineNos 0}}"
              class="source-hunk divide-b"
              style="--line-pad: {{$.FileSearch.LinePad}}ch; --line-no-reset: {{(index $hunk.Lines 0).LineNo}}"
            >
              {{range $_, $line := $hunk.Lines}}
                <div>
                  {{- template "component.source-line" . -}}
                </div>
              {{end}}
            </a>
          {{end}}
        {{end}}
      </div>
    {{end}}
  </section>
{{end}}
