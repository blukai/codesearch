{{block "page.filepath" .}}
  {{template "layout.head" .}}
  <main class="panels">
    {{template "component.panel-file-search" .}}
    {{if .SourceDir}}
      <div>
        {{template "component.breadcrumbs" map "Breadcrumbs" .SourceDir.Breadcrumbs "Query" .Query}}
      </div>
      {{range $_, $entry := .SourceDir.Entries}}
        <div>
          {{if $entry.IsDir}}
            {{/* NOTE: wihtut trailing slash (/) dot-slash (./) will not work */}}
            <a href="./{{$entry.Name}}/?q={{$.Query}}">
              {{$entry.Name}}
            </a>
          {{else}}
            <a href="./{{$entry.Name}}?q={{$.Query}}">
              {{$entry.Name}}
            </a>
          {{end}}
        </div>
      {{end}}
    {{else if .SourceFile}}
      {{
        template "component.panel-source-file" map
          "Breadcrumbs" .SourceDir.Breadcrumbs
          "Query" .Query
          "SourceFile" .SourceFile
      }}
    {{end}}
  </div>
  {{template "layout.foot" .}}
{{end}}
